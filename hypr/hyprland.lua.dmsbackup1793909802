hl.bind(mod .. " + D", hl.dsp.window.move({ direction = "right" }))

-- === Window Resizing ===
-- Legacy `resizeactive ... %` sized the step as a fraction of the *monitor*.
-- hl.dsp.window.resize only takes pixels, so compute the step at press time.
local function resize_by_percent(px, py)
    return function()
        local m = hl.get_active_monitor()
        if not m then
            return
        end
        hl.dispatch(hl.dsp.window.resize({
            x        = math.floor(m.width * px / 100),
            y        = math.floor(m.height * py / 100),
            relative = true,
        }))
    end
end

hl.bind(mod .. " + SHIFT + W", resize_by_percent(0, -10), { repeating = true })
hl.bind(mod .. " + SHIFT + A", resize_by_percent(-10, 0), { repeating = true })
hl.bind(mod .. " + SHIFT + S", resize_by_percent(0, 10),  { repeating = true })
hl.bind(mod .. " + SHIFT + D", resize_by_percent(10, 0),  { repeating = true })

-- === Move/resize windows with mod + LMB/RMB and dragging ===
hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true, description = "Move window" })
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true, description = "Resize window" })

-- === Mouse Wheel Navigation ===
hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- === Numbered Workspaces + Move to Numbered Workspaces ===
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    hl.bind(mod .. " + " .. key,           hl.dsp.focus({ workspace = i }))
    hl.bind(mod .. " + SHIFT + " .. key,   hl.dsp.window.move({ workspace = i }))
end

